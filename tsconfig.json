{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/core/**/*.ts", "src/parsers/**/*.ts", "src/extension/**/*.ts", "src/cli/**/*.ts", "test/unit/**/*.ts", "test/integration/**/*.ts", "test/e2e/**/*.ts", "vitest.config.mts", "vitest.e2e.config.mts"],
  "exclude": ["node_modules", "dist", "src/webview"]
}
