{
  "name": "dbnext",
  "displayName": "DBNext – Database Map & ER Diagram",
  "description": "Instantly understand any project's database. Auto-detects schemas from SQL, Prisma, TypeORM, Drizzle, Sequelize, Mongoose, Django, SQLAlchemy, Rails, Laravel, GORM, JPA/Hibernate, EF Core, Ecto and more, then draws an interactive ER map.",
  "version": "0.2.1",
  "publisher": "suvijya",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/suvijya/dbnext.git"
  },
  "bugs": {
    "url": "https://github.com/suvijya/dbnext/issues"
  },
  "homepage": "https://github.com/suvijya/dbnext#readme",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "database",
    "erd",
    "er diagram",
    "schema",
    "db map",
    "sql",
    "postgres",
    "mysql",
    "sqlite",
    "mongodb",
    "prisma",
    "typeorm",
    "drizzle",
    "sequelize",
    "mongoose",
    "django",
    "sqlalchemy",
    "rails",
    "laravel",
    "gorm",
    "jpa",
    "hibernate",
    "entity framework",
    "ecto",
    "dbml",
    "mermaid"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:dbnext.map"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "dbnext": "dist/cli.js"
  },
  "browser": "./dist/web/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "walkthroughs": [
      {
        "id": "dbnext.gettingStarted",
        "title": "Get started with DBNext",
        "description": "Turn the schema files in your workspace into an interactive map.",
        "steps": [
          {
            "id": "openMap",
            "title": "Open the DB Map",
            "description": "DBNext scans migrations, SQL, ORM models and more, then draws tables and relations.\n[Open DB Map](command:dbnext.openMap)",
            "media": { "image": "media/screenshot.png", "altText": "DB Map showing tables, relations and the details of the selected table" },
            "completionEvents": ["onCommand:dbnext.openMap"]
          },
          {
            "id": "searchFocus",
            "title": "Search and focus",
            "description": "Search for tables and columns in the toolbar, select a table to see its details, and press F to focus on it and its neighbours. Arrow keys move between connected tables.",
            "media": { "image": "media/screenshot-large.png", "altText": "A 100-table schema focused on one table" }
          },
          {
            "id": "export",
            "title": "Export your schema",
            "description": "Export Markdown docs, or copy Mermaid, DBML or PlantUML from the Export menu.\n[Export Markdown](command:dbnext.exportMarkdown)",
            "media": { "image": "media/screenshot.png", "altText": "DB Map diagram of a database schema" },
            "completionEvents": ["onCommand:dbnext.exportMarkdown"]
          },
          {
            "id": "settings",
            "title": "Tune the settings",
            "description": "Exclude folders, disable sources or turn file watching on or off.\n[Open DBNext settings](command:workbench.action.openSettings?%5B%22dbnext%22%5D)",
            "media": { "image": "media/dbnext.svg", "altText": "DBNext logo" }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "dbnext.openMap",
        "title": "Open DB Map",
        "category": "DBNext",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "dbnext.rescan",
        "title": "Rescan Workspace",
        "category": "DBNext",
        "icon": "$(refresh)"
      },
      {
        "command": "dbnext.exportMarkdown",
        "title": "Export DB Map to Markdown (Mermaid)",
        "category": "DBNext",
        "icon": "$(markdown)"
      },
      {
        "command": "dbnext.copyMermaid",
        "title": "Copy Mermaid ER Diagram",
        "category": "DBNext",
        "icon": "$(copy)"
      },
      {
        "command": "dbnext.copyDbml",
        "title": "Copy DBML",
        "category": "DBNext",
        "icon": "$(copy)"
      },
      {
        "command": "dbnext.copyPlantUml",
        "title": "Copy PlantUML ER Diagram",
        "category": "DBNext",
        "icon": "$(copy)"
      },
      {
        "command": "dbnext.exportPng",
        "title": "Export DB Map as PNG",
        "category": "DBNext",
        "icon": "$(file-media)"
      },
      {
        "command": "dbnext.selectView",
        "title": "Select Saved View",
        "category": "DBNext",
        "icon": "$(filter)"
      },
      {
        "command": "dbnext.revealInMap",
        "title": "Show in DB Map",
        "category": "DBNext",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "dbnext.openSource",
        "title": "Go to Definition",
        "category": "DBNext",
        "icon": "$(go-to-file)"
      },
      {
        "command": "dbnext.compareWithRef",
        "title": "Compare with Git Ref…",
        "category": "DBNext",
        "icon": "$(git-compare)"
      },
      {
        "command": "dbnext.copyDiffMarkdown",
        "title": "Copy Schema Diff as Markdown",
        "category": "DBNext",
        "icon": "$(copy)"
      },
      {
        "command": "dbnext.diffWithLiveDatabase",
        "title": "Compare with Live Database (read-only)",
        "category": "DBNext",
        "icon": "$(database)"
      },
      {
        "command": "dbnext.clearLiveDatabasePassword",
        "title": "Forget Live Database Password",
        "category": "DBNext"
      },
      {
        "command": "dbnext.showLog",
        "title": "Show Scan Log",
        "category": "DBNext"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbnext",
          "title": "DB Map",
          "icon": "media/dbnext.svg"
        }
      ]
    },
    "views": {
      "dbnext": [
        {
          "id": "dbnext.schema",
          "name": "Schema",
          "icon": "media/dbnext.svg",
          "contextualTitle": "DB Map"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dbnext.schema",
        "contents": "Open a folder or repository and DBNext will map its databases automatically.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "dbnext.schema",
        "contents": "Scanning the workspace for database schemas…",
        "when": "workbenchState != empty && dbnext.state == scanning"
      },
      {
        "view": "dbnext.schema",
        "contents": "No database schema was detected in this workspace.\nDBNext understands SQL/migrations, DBML, Prisma, TypeORM, MikroORM, Drizzle, Sequelize, Mongoose, Knex, Kysely, Django, SQLAlchemy/Alembic, SQLModel, Rails, Laravel, Doctrine, GORM, JPA/Hibernate, Liquibase, EF Core, Ecto and Diesel.\n[Rescan Workspace](command:dbnext.rescan)\n[Show Scan Log](command:dbnext.showLog)",
        "when": "workbenchState != empty && dbnext.state == empty"
      },
      {
        "view": "dbnext.schema",
        "contents": "The database scan failed.\n[Show Scan Log](command:dbnext.showLog)\n[Rescan Workspace](command:dbnext.rescan)",
        "when": "workbenchState != empty && dbnext.state == error"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dbnext.openMap",
          "when": "view == dbnext.schema",
          "group": "navigation@1"
        },
        {
          "command": "dbnext.rescan",
          "when": "view == dbnext.schema",
          "group": "navigation@2"
        },
        {
          "command": "dbnext.exportMarkdown",
          "when": "view == dbnext.schema",
          "group": "navigation@3"
        },
        {
          "command": "dbnext.copyMermaid",
          "when": "view == dbnext.schema",
          "group": "export@1"
        },
        {
          "command": "dbnext.copyDbml",
          "when": "view == dbnext.schema",
          "group": "export@2"
        },
        {
          "command": "dbnext.copyPlantUml",
          "when": "view == dbnext.schema",
          "group": "export@3"
        },
        {
          "command": "dbnext.showLog",
          "when": "view == dbnext.schema",
          "group": "export@4"
        }
      ],
      "view/item/context": [
        {
          "command": "dbnext.revealInMap",
          "when": "view == dbnext.schema && viewItem =~ /^(entity|externalEntity)$/",
          "group": "inline@1"
        },
        {
          "command": "dbnext.openSource",
          "when": "view == dbnext.schema && viewItem =~ /^(entity|column|enum|engineEvidence|relation|warning)$/",
          "group": "inline@2"
        },
        {
          "command": "dbnext.revealInMap",
          "when": "view == dbnext.schema && viewItem =~ /^(entity|externalEntity)$/",
          "group": "navigation@1"
        },
        {
          "command": "dbnext.openSource",
          "when": "view == dbnext.schema && viewItem =~ /^(entity|column|enum|engineEvidence|relation|warning)$/",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "dbnext.diffWithLiveDatabase",
          "when": "config.dbnext.liveDatabase.enabled && !isWeb"
        },
        {
          "command": "dbnext.clearLiveDatabasePassword",
          "when": "config.dbnext.liveDatabase.enabled && !isWeb"
        },
        {
          "command": "dbnext.revealInMap",
          "when": "false"
        },
        {
          "command": "dbnext.openSource",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "DBNext",
      "properties": {
        "dbnext.autoOpen": {
          "type": "string",
          "enum": [
            "firstTime",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Open the DB Map automatically the first time a schema is found in a workspace.",
            "Open the DB Map automatically every time a workspace with a schema is opened.",
            "Never open the DB Map automatically."
          ],
          "default": "firstTime",
          "description": "When to open the DB Map automatically after the workspace is scanned."
        },
        "dbnext.inferRelations": {
          "type": "boolean",
          "default": true,
          "description": "Infer relationships from naming conventions (for example `user_id` → `users.id`) when no explicit foreign key exists. Inferred relations are drawn with dashed lines."
        },
        "dbnext.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional glob patterns to exclude from scanning (for example `**/fixtures/**`)."
        },
        "dbnext.disabledSources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "sql",
              "dbml",
              "diesel",
              "prisma",
              "typeorm",
              "mikroorm",
              "drizzle",
              "sequelize",
              "mongoose",
              "knex",
              "kysely",
              "django",
              "sqlalchemy",
              "sqlmodel",
              "peewee",
              "tortoise",
              "rails",
              "laravel",
              "doctrine",
              "gorm",
              "ent",
              "bun",
              "jpa",
              "exposed",
              "liquibase",
              "efcore",
              "ecto",
              "seaorm",
              "hibernate",
              "doctrinemap",
              "graphql",
              "zenstack",
              "mongovalidator"
            ]
          },
          "default": [],
          "description": "Schema sources to ignore while scanning."
        },
        "dbnext.maxFiles": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "description": "Maximum number of source files to inspect per scan."
        },
        "dbnext.maxFileSizeKB": {
          "type": "number",
          "default": 2048,
          "minimum": 16,
          "description": "Files larger than this (in KB) are skipped."
        },
        "dbnext.watch": {
          "type": "boolean",
          "default": true,
          "description": "Update the DB Map automatically when schema files change."
        },
        "dbnext.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the DB Map summary in the status bar."
        },
        "dbnext.liveDatabase.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Allow DBNext to connect to a database and run read-only catalog queries to compare it with the code-derived model. Desktop only. The password is kept in VS Code SecretStorage, never in settings."
        },
        "dbnext.liveDatabase.engine": { "type": "string", "enum": ["postgresql", "mysql"], "default": "postgresql", "scope": "machine", "description": "Database engine (PostgreSQL or MySQL/MariaDB)." },
        "dbnext.liveDatabase.host": { "type": "string", "default": "localhost", "scope": "machine", "description": "Database host." },
        "dbnext.liveDatabase.port": { "type": "number", "default": 0, "scope": "machine", "description": "Database port (0 = engine default)." },
        "dbnext.liveDatabase.database": { "type": "string", "default": "", "scope": "machine", "description": "Database name." },
        "dbnext.liveDatabase.user": { "type": "string", "default": "", "scope": "machine", "description": "Database user (use a read-only account)." },
        "dbnext.export.path": {
          "type": "string",
          "default": "DBMAP.md",
          "description": "Workspace-relative path of the Markdown file written by “Export DB Map to Markdown”."
        },
        "dbnext.export.autoUpdate": {
          "type": "boolean",
          "default": false,
          "description": "Rewrite the Markdown DB map file automatically after every scan (only if it already exists or was exported once)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:prod": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/webview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "test:integration": "node esbuild.mjs && node test/integration/runTest.mjs",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/vscode": "1.80.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "mysql2": "3.24.6",
    "pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
